# Copie ce fichier en .env et complete les valeurs.
# Le .env n'est jamais versionne : il contient des secrets.

# --- Serveur ---
PORT=8787
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=data/montre.sqlite

# --- Strava ---
# Cree une application sur https://www.strava.com/settings/api
# "Authorization Callback Domain" doit valoir localhost en developpement.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback
