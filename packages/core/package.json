{
  "name": "@montre/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domaine partage : parseurs de fichiers d'activite, metriques physiologiques, charge d'entrainement et moteur de coaching.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
